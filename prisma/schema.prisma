generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  CAMPUS_ADMIN
  FACULTY
  STUDENT
  PARENT
  CREATOR
  SUPERVISOR
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  EXPIRED
}

model SubscriptionPlan {
  id             Int       @id @default(autoincrement())
  name           String    @unique
  price          Decimal   @db.Decimal(10, 2)
  durationMonths Int       @default(1)
  maxStudents    Int       @default(500)
  features       String    @db.Text
  cmsEnabled     Boolean   @default(true)
  lmsEnabled     Boolean   @default(true)
  obeEnabled     Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenants        Tenant[]

  @@map("subscription_plans")
}

model Tenant {
  id                  String       @id @default(uuid()) @db.Uuid
  code                String       @unique @db.VarChar(50)
  name                String       @db.VarChar(255)
  domain              String       @unique @db.VarChar(255)
  planId              Int
  status              TenantStatus @default(ACTIVE)
  cmsEnabled          Boolean      @default(true)
  lmsEnabled          Boolean      @default(true)
  obeEnabled          Boolean      @default(false)
  subscriptionEndDate DateTime?
  adminEmail          String?      @db.VarChar(255)

  // White-labeling branding
  primaryColor        String       @default("#7C3AED") @db.VarChar(50)
  primaryHover        String       @default("#6D28D9") @db.VarChar(50)
  primaryLight        String       @default("#F3E8FF") @db.VarChar(50)
  accentColor         String       @default("#06B6D4") @db.VarChar(50)
  logoUrl             String?      @db.Text
  faviconUrl          String?      @db.Text

  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  plan                SubscriptionPlan @relation(fields: [planId], references: [id])
  users               User[]
  activityLogs        ActivityLog[]
  payments            Payment[]
  notifications       Notification[]
  departments         Department[]
  programs            Program[]
  academicYears       AcademicYear[]
  semesters           Semester[]
  cohorts             Cohort[]
  sections            Section[]
  subjects            Subject[]
  regulations         Regulation[]
  timetablePeriods    TimetablePeriod[]
  timetableSlots      TimetableSlot[]
  studyMaterials      StudyMaterial[]
  accessGroups        AccessGroup[]
  leads               Lead[]
  applications        Application[]
  studentProfiles     StudentProfile[]
  staffProfiles       StaffProfile[]
  leaveApplications   LeaveApplication[]
  payrollRuns         PayrollRun[]
  payslips            Payslip[]
  staffDuties         StaffDuty[]
  staffCertificates   StaffCertificate[]
  staffChecklists     StaffChecklist[]
  payrollComponents   PayrollComponent[]
  salaryStructures    SalaryStructure[]
  attendanceRecords   AttendanceRecord[]
  exams               Exam[]
  examSchedules       ExamSchedule[]
  examMarks           ExamMark[]
  courseOutcomes      CourseOutcome[]
  programOutcomes     ProgramOutcome[]
  coPoMappings        CoPoMapping[]
  coAttainments       CoAttainment[]
  feeStructures       FeeStructure[]
  feeTypes            FeeType[]
  studentInvoices     StudentInvoice[]
  feePayments         FeePayment[]
  daybookEntries      DaybookEntry[]

  // Phase 6: Facilities & Operations
  hostels             Hostel[]
  hostelRooms         HostelRoom[]
  hostelAllocations   HostelAllocation[]
  hostelOutings       HostelOuting[]
  transportVehicles   TransportVehicle[]
  transportRoutes     TransportRoute[]
  transportStops      TransportStop[]
  transportSubscriptions TransportSubscription[]
  transportLogs       TransportLog[]
  libraryCategories   LibraryCategory[]
  libraryBooks        LibraryBook[]
  libraryIssues       LibraryIssue[]
  libraryMembers      LibraryMember[]
  libraryPeriodicals  LibraryPeriodical[]
  librarySuppliers    LibrarySupplier[]
  libraryStockAudits  LibraryStockAudit[]
  visitorPasses       VisitorPass[]
  postalRecords       PostalRecord[]
  frontOfficeCallLogs FrontOfficeCallLog[]
  frontOfficeEnquiries FrontOfficeEnquiry[]
  accountHeads        AccountHead[]
  bankAccounts        BankAccount[]
  financialTransactions FinancialTransaction[]

  // Phase 7: Faculty Workspace & Class Monitor
  facultySubjectAllocations FacultySubjectAllocation[]
  classSessions             ClassSession[]
  periodAttendances         PeriodAttendance[]
  continuousAssessments     ContinuousAssessment[]
  continuousAssessmentMarks ContinuousAssessmentMark[]
  lessonPlans               LessonPlan[]

  // Phase 8: Student LMS, Parent Portal, Creator Studio & Notifications
  lmsCourses                LmsCourse[]
  lmsCourseModules          LmsCourseModule[]
  lmsCourseLessons          LmsCourseLesson[]
  lmsCourseEnrollments      LmsCourseEnrollment[]
  cbtExamSessions           CbtExamSession[]
  parentProfiles            ParentProfile[]
  parentRemarks             ParentRemark[]

  // Phase 9: Admissions CRM & Auxiliaries
  admissionCategories       AdmissionCategory[]
  admissionDocuments        AdmissionDocument[]
  admissionScholarships     AdmissionScholarship[]
  admissionPayments         AdmissionPayment[]

  // Phase 10, 11, 12: Backlogs, CBT Quizzes & Placements
  examBacklogs              ExamBacklog[]
  cbtQuizzes                CbtQuiz[]
  placementCompanies        PlacementCompany[]
  placementDrives           PlacementDrive[]
  placementApplications     PlacementApplication[]
  placementOffers           PlacementOffer[]
  internshipPostings        InternshipPosting[]

  // Phase 13: Student Self-Service Portal & Digital ID
  studentCertificateRequests StudentCertificateRequest[]
  studentComplaints          StudentComplaint[]
  studentFeedbacks           StudentFeedback[]
  academicNotices            AcademicNotice[]
  studentExamRegistrations   StudentExamRegistration[]

  @@index([code])
  @@index([domain])
  @@map("tenants")
}

model SuperAdmin {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique @db.VarChar(255)
  passwordHash String   @db.VarChar(255)
  name         String   @db.VarChar(255)
  role         Role     @default(SUPER_ADMIN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("super_admins")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  role         Role     @default(STUDENT)
  name         String   @db.VarChar(255)
  email        String?  @db.VarChar(255)
  passwordHash String   @db.VarChar(255)
  phone        String?  @db.VarChar(50)
  status       String   @default("active") @db.VarChar(50)

  // Institutional Scoped Identifiers
  rollNumber   String?  @db.VarChar(100)
  employeeCode String?  @db.VarChar(100)

  // Student specific metadata
  program      String?  @db.VarChar(255)
  semester     String?  @db.VarChar(50)
  section      String?  @db.VarChar(50)

  // Faculty specific metadata
  department   String?  @db.VarChar(255)
  designation  String?  @db.VarChar(255)

  // Parent specific metadata
  studentId    String?  @db.Uuid

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  notifications Notification[]
  studentProfile StudentProfile?
  staffProfile   StaffProfile?
  parentProfile  ParentProfile?

  // Composite uniqueness rules (Golden Rules Section 2.2)
  @@unique([tenantId, rollNumber])
  @@unique([tenantId, employeeCode])
  @@index([tenantId])
  @@index([role])
  @@map("users")
}

model ActivityLog {
  id        BigInt   @id @default(autoincrement())
  tenantId  String?  @db.Uuid
  user      String   @db.VarChar(255)
  action    String   @db.VarChar(255)
  details   String   @db.Text
  type      String   @default("info") @db.VarChar(50)
  createdAt DateTime @default(now())

  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("activity_logs")
}

model Payment {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  invoiceId     String   @unique @db.VarChar(100)
  amount        Decimal  @db.Decimal(12, 2)
  paymentMethod String   @db.VarChar(100)
  status        String   @default("completed") @db.VarChar(50)
  createdAt     DateTime @default(now())

  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("payments")
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  userId    String   @db.Uuid
  title     String   @db.VarChar(255)
  message   String   @db.Text
  isRead    Boolean  @default(false)
  type      String   @default("info") @db.VarChar(50)
  createdAt DateTime @default(now())

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, isRead])
  @@map("notifications")
}

// ==========================================
// PHASE 2: CAMPUS SYSTEMS & ACADEMIC STRUCTURE
// ==========================================

model Department {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @db.Uuid
  code             String    @db.VarChar(50)
  name             String    @db.VarChar(255)
  headOfDepartment String?   @db.VarChar(255)
  status           String    @default("active") @db.VarChar(50)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  programs         Program[]
  subjects         Subject[]
  staffProfiles    StaffProfile[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("departments")
}

model Program {
  id            String      @id @default(uuid()) @db.Uuid
  tenantId      String      @db.Uuid
  departmentId  String      @db.Uuid
  code          String      @db.VarChar(100)
  name          String      @db.VarChar(255)
  type          String      @default("UG") @db.VarChar(50)
  durationYears Int         @default(4)
  pos           Json?
  status        String      @default("active") @db.VarChar(50)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department    Department  @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  cohorts       Cohort[]
  leads         Lead[]
  applications  Application[]
  studentProfiles StudentProfile[]
  programOutcomes ProgramOutcome[]
  feeStructures   FeeStructure[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([departmentId])
  @@map("programs")
}

model AcademicYear {
  id        String     @id @default(uuid()) @db.Uuid
  tenantId  String     @db.Uuid
  name      String     @db.VarChar(100)
  startDate DateTime
  endDate   DateTime
  status    String     @default("active") @db.VarChar(50)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cohorts   Cohort[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("academic_years")
}

model Semester {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  name      String   @db.VarChar(100)
  sequence  Int      @default(1)
  status    String   @default("active") @db.VarChar(50)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sequence])
  @@index([tenantId])
  @@map("semesters")
}

model Regulation {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  code           String   @db.VarChar(50)
  name           String   @db.VarChar(255)
  startYear      Int      @default(2026)
  totalCredits   Int      @default(160)
  passPercentage Decimal  @default(40.0) @db.Decimal(5, 2)
  description    String?  @db.Text
  status         String   @default("active") @db.VarChar(50)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("regulations")
}

model Cohort {
  id             String        @id @default(uuid()) @db.Uuid
  tenantId       String        @db.Uuid
  programId      String        @db.Uuid
  academicYearId String?       @db.Uuid
  name           String        @db.VarChar(255)
  semesterName   String?       @db.VarChar(100)
  status         String        @default("active") @db.VarChar(50)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  program        Program       @relation(fields: [programId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  sections       Section[]
  studentProfiles StudentProfile[]
  coAttainments  CoAttainment[]
  timetableSlots TimetableSlot[]
  studyMaterials StudyMaterial[]

  @@index([tenantId])
  @@index([programId])
  @@map("cohorts")
}

model Section {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @db.Uuid
  cohortId        String   @db.Uuid
  name            String   @db.VarChar(100)
  maxStudents     Int      @default(60)
  currentEnrolled Int      @default(0)
  status          String   @default("active") @db.VarChar(50)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cohort          Cohort   @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  studentProfiles StudentProfile[]
  attendanceRecords AttendanceRecord[]
  timetableSlots    TimetableSlot[]

  @@index([tenantId])
  @@index([cohortId])
  @@map("sections")
}

model Subject {
  id           String      @id @default(uuid()) @db.Uuid
  tenantId     String      @db.Uuid
  departmentId String?     @db.Uuid
  code         String      @db.VarChar(100)
  name         String      @db.VarChar(255)
  shortName    String?     @db.VarChar(50)
  type         String      @default("Theory") @db.VarChar(50)
  credits      Decimal     @default(3.0) @db.Decimal(4, 1)
  sessions     Int         @default(45)
  status       String      @default("active") @db.VarChar(50)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  attendanceRecords AttendanceRecord[]
  examSchedules     ExamSchedule[]
  courseOutcomes    CourseOutcome[]
  facultySubjectAllocations FacultySubjectAllocation[]
  classSessions             ClassSession[]
  continuousAssessments     ContinuousAssessment[]
  lessonPlans               LessonPlan[]
  timetableSlots            TimetableSlot[]
  studyMaterials            StudyMaterial[]
  examBacklogs              ExamBacklog[]
  cbtQuizzes                CbtQuiz[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("subjects")
}

model AccessGroup {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @db.Uuid
  name             String   @db.VarChar(255)
  description      String?  @db.Text
  permissionsCount Int      @default(0)
  createdBy        String?  @default("System") @db.VarChar(100)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("access_groups")
}

model TimetablePeriod {
  id           String          @id @default(uuid()) @db.Uuid
  tenantId     String          @db.Uuid
  name         String          @db.VarChar(100)
  periodNumber Int             @default(1)
  startTime    String          @db.VarChar(20)
  endTime      String          @db.VarChar(20)
  isBreak      Boolean         @default(false)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  slots        TimetableSlot[]

  @@index([tenantId])
  @@map("timetable_periods")
}

model TimetableSlot {
  id        String          @id @default(uuid()) @db.Uuid
  tenantId  String          @db.Uuid
  day       String          @db.VarChar(20)
  periodId  String          @db.Uuid
  cohortId  String?         @db.Uuid
  sectionId String?         @db.Uuid
  subjectId String          @db.Uuid
  staffId   String?         @db.Uuid
  room      String?         @db.VarChar(100)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  period    TimetablePeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  cohort    Cohort?         @relation(fields: [cohortId], references: [id], onDelete: SetNull)
  section   Section?        @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  subject   Subject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  staff     StaffProfile?   @relation(fields: [staffId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([periodId])
  @@index([sectionId])
  @@index([subjectId])
  @@index([staffId])
  @@map("timetable_slots")
}

model StudyMaterial {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  subjectId   String   @db.Uuid
  cohortId    String?  @db.Uuid
  title       String   @db.VarChar(255)
  description String?  @db.Text
  type        String   @default("PDF") @db.VarChar(50)
  fileUrl     String?  @db.Text
  fileName    String?  @db.VarChar(255)
  uploadedBy  String?  @db.VarChar(255)
  status      String   @default("active") @db.VarChar(50)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subject     Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  cohort      Cohort?  @relation(fields: [cohortId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([subjectId])
  @@map("study_materials")
}

model Lead {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @db.Uuid
  fullName     String    @db.VarChar(255)
  email        String?   @db.VarChar(255)
  phone        String    @db.VarChar(50)
  city         String?   @db.VarChar(100)
  programId    String?   @db.Uuid
  programName  String?   @db.VarChar(255)
  source       String    @default("Website") @db.VarChar(100)
  status       String    @default("new") @db.VarChar(50)
  assignedTo   String?   @db.VarChar(255)
  followUpDate DateTime?
  notes        String?   @db.Text
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  program      Program?  @relation(fields: [programId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([status])
  @@map("leads")
}

model Application {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @db.Uuid
  applicationNumber String    @db.VarChar(100)
  fullName          String    @db.VarChar(255)
  email             String    @db.VarChar(255)
  phone             String    @db.VarChar(50)
  programId         String?   @db.Uuid
  programName       String?   @db.VarChar(255)
  admissionCategory String    @default("General") @db.VarChar(100)
  qualification     String?   @db.VarChar(100)
  board             String?   @db.VarChar(100)
  passingYear       Int?
  marks             Decimal?  @db.Decimal(5, 2)
  status            String    @default("submitted") @db.VarChar(50)
  offerLetterSent   Boolean   @default(false)
  offerLetterUrl    String?   @db.Text
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  program           Program?  @relation(fields: [programId], references: [id], onDelete: SetNull)
  documents         AdmissionDocument[]
  payments          AdmissionPayment[]

  @@unique([tenantId, applicationNumber])
  @@index([tenantId])
  @@index([status])
  @@map("applications")
}

model StudentProfile {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @db.Uuid
  userId          String?   @unique @db.Uuid
  rollNumber      String    @db.VarChar(100)
  firstName       String    @db.VarChar(100)
  lastName        String?   @db.VarChar(100)
  email           String?   @db.VarChar(255)
  phone           String?   @db.VarChar(50)
  programId       String?   @db.Uuid
  cohortId        String?   @db.Uuid
  sectionId       String?   @db.Uuid
  currentSemester Int       @default(1)
  parentName      String?   @db.VarChar(255)
  parentPhone     String?   @db.VarChar(50)
  parentEmail     String?   @db.VarChar(255)
  gender          String?   @db.VarChar(20)
  dob             DateTime?
  bloodGroup      String?   @db.VarChar(10)
  address         String?   @db.Text
  status          String    @default("active") @db.VarChar(50)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user            User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  program         Program?  @relation(fields: [programId], references: [id], onDelete: SetNull)
  cohort          Cohort?   @relation(fields: [cohortId], references: [id], onDelete: SetNull)
  section         Section?  @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  attendanceRecords AttendanceRecord[]
  examMarks         ExamMark[]
  invoices          StudentInvoice[]
  hostelAllocations   HostelAllocation[]
  hostelOutings       HostelOuting[]
  transportSubscriptions TransportSubscription[]
  libraryIssues       LibraryIssue[]
  libraryMembers      LibraryMember[]
  periodAttendances   PeriodAttendance[]
  continuousAssessmentMarks ContinuousAssessmentMark[]
  lmsEnrollments      LmsCourseEnrollment[]
  cbtExamSessions     CbtExamSession[]
  parentProfiles      ParentProfile[]
  parentRemarks       ParentRemark[]
  scholarships        AdmissionScholarship[]
  examBacklogs        ExamBacklog[]
  placementApplications PlacementApplication[]
  placementOffers     PlacementOffer[]

  @@unique([tenantId, rollNumber])
  @@index([tenantId])
  @@index([programId])
  @@index([cohortId])
  @@index([status])
  @@map("student_profiles")
}

model AdmissionCategory {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @db.Uuid
  name            String   @db.VarChar(150)
  code            String   @db.VarChar(50)
  quotaPercentage Decimal  @default(0.0) @db.Decimal(5, 2)
  description     String?  @db.Text
  status          String   @default("active") @db.VarChar(50)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("admission_categories")
}

model AdmissionDocument {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @db.Uuid
  applicationId   String   @db.Uuid
  documentType    String   @db.VarChar(100)
  documentName    String?  @db.VarChar(255)
  status          String   @default("Pending") @db.VarChar(50)
  verifiedBy      String?  @db.VarChar(255)
  verifiedAt      DateTime?
  remarks         String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  application     Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([tenantId, applicationId])
  @@map("admission_documents")
}

model AdmissionScholarship {
