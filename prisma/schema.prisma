model PlacementCompany {
  id            String             @id @default(uuid()) @db.Uuid
  tenantId      String             @db.Uuid
  name          String             @db.VarChar(255)
  industry      String             @db.VarChar(150)
  tier          String             @default("Tier 1") @db.VarChar(50) // Super Dream, Tier 1, Core Engineering
  hrName        String?            @db.VarChar(100)
  hrEmail       String?            @db.VarChar(255)
  hrPhone       String?            @db.VarChar(50)
  website       String?            @db.VarChar(255)
  location      String?            @db.VarChar(255)
  mouSigned     Boolean            @default(false)
  status        String             @default("Active") @db.VarChar(50)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  drives        PlacementDrive[]
  offers        PlacementOffer[]

  @@index([tenantId])
  @@index([tier])
  @@map("placement_companies")
}

model PlacementDrive {
  id            String                 @id @default(uuid()) @db.Uuid
  tenantId      String                 @db.Uuid
  companyId     String                 @db.Uuid
  title         String                 @db.VarChar(255)
  jobRole       String                 @db.VarChar(150)
  ctcDetails    String?                @db.VarChar(100) // e.g. "₹24.0 LPA"
  ctcNumeric    Decimal                @default(0.0) @db.Decimal(12, 2)
  driveDate     DateTime?              @db.Date
  deadlineDate  DateTime?              @db.Date
  requiredCgpa  Decimal                @default(6.5) @db.Decimal(3, 1)
  maxBacklogs   Int                    @default(0)
  location      String?                @db.VarChar(255)
  status        String                 @default("Active") @db.VarChar(50) // Active, Upcoming, Completed
  description   String?                @db.Text
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  tenant        Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company       PlacementCompany       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  applications  PlacementApplication[]

  @@index([tenantId])
  @@index([companyId])
  @@index([status])
  @@map("placement_drives")
}

model PlacementApplication {
  id            String         @id @default(uuid()) @db.Uuid
  tenantId      String         @db.Uuid
  driveId       String         @db.Uuid
  studentId     String         @db.Uuid
  currentRound  String         @default("Round 1: Online Assessment") @db.VarChar(150)
  status        String         @default("In Progress") @db.VarChar(50) // In Progress, Selected, Rejected
  resumeUrl     String?        @db.VarChar(500)
  remarks       String?        @db.Text
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  drive         PlacementDrive @relation(fields: [driveId], references: [id], onDelete: Cascade)
  student       StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([tenantId, driveId, studentId])
  @@index([tenantId])
  @@index([driveId])
  @@index([studentId])
  @@index([status])
  @@map("placement_applications")
}

model PlacementOffer {
  id              String           @id @default(uuid()) @db.Uuid
  tenantId        String           @db.Uuid
  studentId       String           @db.Uuid
  companyId       String           @db.Uuid
  jobRole         String           @db.VarChar(150)
  ctc             Decimal          @db.Decimal(12, 2)
