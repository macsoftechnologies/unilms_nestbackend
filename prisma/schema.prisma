  level        String                @default("Beginner") @db.VarChar(50)
  thumbnail    String?               @db.VarChar(500)
  instructorId String?               @db.Uuid
  isPublished  Boolean               @default(false)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  instructor   StaffProfile?         @relation(fields: [instructorId], references: [id], onDelete: SetNull)
  modules      LmsCourseModule[]
  enrollments  LmsCourseEnrollment[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([category])
  @@map("lms_courses")
}

